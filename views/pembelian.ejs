<h2>Data Pembelian</h2>
<table border="1">
<tr>
  <th>Produk</th><th>Qty</th><th>Total</th><th>Status</th><th>Aksi</th>
</tr>
<% data.forEach(d => { %>
<tr>
  <td><%= d.nama_produk %></td>
  <td><%= d.qty %></td>
  <td><%= d.total %></td>
  <td><%= d.status %></td>
  <td>
    <% if(d.status === 'AKTIF') { %>
    <form method="POST" action="/cancel/<%= d.id %>">
      <button>Cancel</button>
    </form>
    <% } %>
  </td>
</tr>
<% }) %>
</table>
